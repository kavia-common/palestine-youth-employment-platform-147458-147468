# Application
APP_NAME=YEP Job Matching API
APP_ENV=development
PORT=8000

# CORS (comma separated or * for all)
CORS_ORIGINS=http://localhost:3000,https://your-frontend.app

# Database (Supabase Postgres)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_here
SUPABASE_ANON_KEY=anon_key_here
SUPABASE_JWT_SECRET=jwt_secret_from_supabase_settings

# Auth/JWT (for API-issued tokens)
JWT_SECRET_KEY=change_me_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Providers
EMBEDDINGS_PROVIDER= # e.g., openai, voyageai
EMBEDDINGS_API_KEY=
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
