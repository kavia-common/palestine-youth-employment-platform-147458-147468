# Example environment variables for Job Matching Backend (FastAPI)

# Application
APP_NAME=YEP Job Matching API
APP_ENV=development
PORT=8000

# CORS (allow local frontend)
# For local dev, permit React dev server at http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database (Supabase Postgres connection string)
# Example: postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT_HOST:5432/postgres
# Note: sslmode=require is auto-appended by the backend if not provided.
DATABASE_URL=postgresql://username:password@host:5432/dbname

# Supabase project configuration
SUPABASE_URL=https://your-project.supabase.co
# Prefer service role key for server-side operations; do not use anon in backend.
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# JWT secret from Supabase settings (used to mint realtime-compatible tokens)
SUPABASE_JWT_SECRET=your-jwt-secret

# API JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Providers (optional)
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
