# Example environment variables for job_matching_backend
# Copy to .env and set appropriate values. Do NOT commit real secrets.

# App
APP_NAME=YEP Job Matching API
APP_ENV=development
PORT=8000

# CORS
# Comma-separated list or * to allow all (dev only)
CORS_ORIGINS=*

# Database
# Required for any route that accesses the database.
# Provide a Postgres URI, e.g.:
# postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# On Supabase, use the Project > Database > Connection string.
DATABASE_URL=postgresql://postgres.vynjybqmgubbtbqcpvtq:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase
# Project URL: https://<project>.supabase.co
SUPABASE_URL=
# Service role key (server-side). Also accepts env alias SUPABASE_KEY or supabase_key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ5bmp5YnFtZ3ViYnRicWNwdnRxIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1OTg0NTg3NSwiZXhwIjoyMDc1NDIxODc1fQ.RKXi-DlhXSqhEGqc8qT9gqAT9yNeRZrnGrvHH1z6O0k
# Anon key (client-side)
SUPABASE_ANON_KEY=
# JWT secret used to mint realtime-compatible JWTs (from Supabase Settings > API)
SUPABASE_JWT_SECRET=TGJHvBiXEaIi+SWWpD3Qyr6w0FENvvJtg0LpyUjYUo7xD+3GW7jeripLJ3d+IRjDh1cv2UXHwFDG8q9qPYkJjA==

# Auth/JWT for backend-issued tokens
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
# Change for non-dev
JWT_SECRET_KEY=local-dev-secret-change

# Optional providers
EMBEDDINGS_PROVIDER=
EMBEDDINGS_API_KEY=
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
