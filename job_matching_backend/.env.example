# Application
APP_NAME=YEP Job Matching API
APP_ENV=development
PORT=8000

# CORS
# Comma-separated list of allowed origins. For local frontend:
CORS_ORIGINS=http://localhost:3000

# Database (Supabase Postgres URL)
# Example (replace with your actual Supabase DB URL). Do not quote.
# Supabase typically requires SSL; backend enforces sslmode=require if not provided.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Supabase
# Project URL (used by clients/services if needed)
SUPABASE_URL=https://your-project.supabase.co
# Keys are provided by orchestrator; do not hardcode real values.
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Auth/JWT for backend-issued API tokens (development-only default is set in code)
JWT_SECRET_KEY=change-me-dev-secret
JWT_ALGORITHM=HS256

# Logging
LOG_LEVEL=INFO

# Debug / diagnostics
# Set to true to enable the /api/debug/db-config endpoint (do not enable in production)
DEBUG_DB_CONFIG=false
