# Application
APP_NAME=YEP Job Matching API
APP_ENV=development
PORT=8000

# CORS
# For local frontend dev, explicitly allow React dev server origin
CORS_ORIGINS=http://localhost:3000

# Database (Supabase Postgres URI)
# Example placeholder (replace with your actual Supabase connection string):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Notes:
# - The backend will normalize to use the psycopg v3 driver (postgresql+psycopg://)
# - If sslmode is not set, the backend enforces sslmode=require automatically
DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Auth tokens issued by backend (local dev default OK; change for production)
JWT_SECRET_KEY=local-dev-secret-change
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional: Enable DB config debug endpoint at /api/debug/db-config
DEBUG_DB_CONFIG=false

# Logging
LOG_LEVEL=INFO
